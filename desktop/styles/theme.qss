/* ============================================================
 * 量化交易系统 - 桌面客户端全局样式 (theme.qss)
 * v2.0 — 基于 UI 重设计规范，引入 design token
 *
 * 设计规范色值映射：
 *   --color-primary-50:  #E6F1FB  --color-neutral-0:  #FFFFFF
 *   --color-primary-100: #B5D4F4  --color-neutral-50:  #F8F9FA
 *   --color-primary-500: #378ADD  --color-neutral-100: #F1F3F5
 *   --color-primary-700: #185FA5  --color-neutral-200: #E9ECEF
 *   --color-primary-900: #042C53  --color-neutral-400: #ADB5BD
 *   --color-up:     #E24B4A      --color-neutral-600: #6C757D
 *   --color-down:   #639922      --color-neutral-800: #343A40
 *   --color-warning:#EF9F27      --color-neutral-900: #212529
 *   --color-error:  #E24B4A
 *   --color-success:#639922
 * ============================================================ */

/* ---------- 全局 ---------- */
* {
    font-family: "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
}

QMainWindow {
    background-color: #F8F9FA;  /* --color-neutral-50 */
}

QWidget {
    color: #343A40;  /* --color-neutral-800 */
    font-size: 14px;  /* --font-body */
    line-height: 22px;
}

/* ---------- 侧边导航栏 ---------- */
QListWidget#navList {
    background-color: #FFFFFF;  /* --color-neutral-0 */
    border: none;
    border-right: 1px solid #E9ECEF;  /* --color-neutral-200 */
    font-size: 14px;
    font-weight: 500;
    padding: 8px 0px;
    outline: none;
}

QListWidget#navList::item {
    padding: 14px 20px;
    border-left: 3px solid transparent;
    color: #6C757D;  /* --color-neutral-600 */
}

QListWidget#navList::item:hover {
    background-color: #E6F1FB;  /* --color-primary-50 */
    border-left: 3px solid #B5D4F4;  /* --color-primary-100 */
    color: #378ADD;  /* --color-primary-500 */
}

QListWidget#navList::item:selected {
    background-color: #B5D4F4;  /* --color-primary-100 */
    border-left: 3px solid #378ADD;  /* --color-primary-500 */
    color: #042C53;  /* --color-primary-900 */
    font-weight: 600;
}

/* ---------- Hero 头部 ---------- */
QFrame#heroHeader {
    background-color: #378ADD;  /* --color-primary-500 */
    border-radius: 12px;  /* --radius-lg */
    padding: 20px 24px;
}

QFrame#heroHeader QLabel#heroTitle {
    color: #ffffff;
    font-size: 22px;
    font-weight: 700;
}

QFrame#heroHeader QLabel#heroSubtitle {
    color: #E6F1FB;  /* --color-primary-50 */
    font-size: 13px;
}

QFrame#heroHeader QLabel#heroBadge {
    color: #E6F1FB;
    background-color: rgba(255, 255, 255, 30);
    border: 1px solid rgba(255, 255, 255, 60);
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 12px;
}

/* ---------- 页面标题（新设计：H1 样式，无背景色） ---------- */
QFrame#pageTitle {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
}

QFrame#pageTitle QLabel#pageTitleMain {
    color: #212529;  /* --color-neutral-900 */
    font-size: 20px;  /* --font-h1 */
    font-weight: 600;
    line-height: 28px;
}

QFrame#pageTitle QLabel#pageTitleSub {
    color: #6C757D;  /* --color-neutral-600 */
    font-size: 14px;  /* --font-body */
    line-height: 22px;
}

/* ---------- 区块标题 ---------- */
QFrame#sectionTitle {
    background-color: #E6F1FB;  /* --color-primary-50 */
    border-left: 4px solid #378ADD;  /* --color-primary-500 */
    border-radius: 8px;  /* --radius-md */
    padding: 10px 14px;
}

QFrame#sectionTitle QLabel#sectionMain {
    color: #212529;  /* --color-neutral-900 */
    font-size: 16px;  /* --font-h2 */
    font-weight: 600;
}

QFrame#sectionTitle QLabel#sectionDesc {
    color: #6C757D;  /* --color-neutral-600 */
    font-size: 12px;  /* --font-caption */
}

/* ---------- 按钮 ---------- */

/* 次级按钮（Secondary） — 默认 */
QPushButton {
    background-color: #FFFFFF;  /* --color-neutral-0 */
    border: 1px solid #E9ECEF;  /* --color-neutral-200 */
    border-radius: 4px;  /* --radius-sm */
    padding: 0 16px;
    color: #343A40;  /* --color-neutral-800 */
    font-size: 14px;  /* --font-body-medium */
    font-weight: 500;
    min-height: 32px;
}

QPushButton:hover {
    background-color: #F8F9FA;  /* --color-neutral-50 */
    border-color: #ADB5BD;  /* --color-neutral-400 */
}

QPushButton:pressed {
    background-color: #F1F3F5;  /* --color-neutral-100 */
}

QPushButton:disabled {
    color: #ADB5BD;  /* --color-neutral-400 */
    background-color: #FFFFFF;
    border-color: #E9ECEF;
}

/* 主按钮（Primary） */
QPushButton#primaryBtn {
    background-color: #378ADD;  /* --color-primary-500 */
    border: none;
    color: #ffffff;
    font-weight: 500;
    border-radius: 4px;  /* --radius-sm */
}

QPushButton#primaryBtn:hover {
    background-color: #185FA5;  /* --color-primary-700 */
}

QPushButton#primaryBtn:pressed {
    background-color: #042C53;  /* --color-primary-900 */
}

QPushButton#primaryBtn:disabled {
    background-color: #B5D4F4;  /* --color-primary-100 */
    color: #ffffff;
}

/* 危险按钮（Danger） */
QPushButton#dangerBtn {
    background-color: #FFFFFF;
    border: 1px solid #E24B4A;  /* --color-error */
    color: #E24B4A;  /* --color-error */
    border-radius: 4px;
}

QPushButton#dangerBtn:hover {
    background-color: #FFF5F5;
    border-color: #E24B4A;
}

QPushButton#dangerBtn:pressed {
    background-color: #FED7D7;
}

/* 图标按钮（Ghost） — 32×32px */
QPushButton#iconBtn {
    background-color: transparent;
    border: none;
    border-radius: 4px;  /* --radius-sm */
    padding: 0;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    color: #6C757D;  /* --color-neutral-600 */
}

QPushButton#iconBtn:hover {
    background-color: #F1F3F5;  /* --color-neutral-100 */
    color: #343A40;  /* --color-neutral-800 */
}

QPushButton#iconBtn:pressed {
    background-color: #E9ECEF;  /* --color-neutral-200 */
}

/* 刷新按钮 loading 状态 */
QPushButton#refreshBtn {
    background-color: #FFFFFF;
    border: 1px solid #E9ECEF;
    border-radius: 4px;
    padding: 0 16px;
    color: #343A40;
    font-size: 14px;
    font-weight: 500;
    min-height: 32px;
}

QPushButton#refreshBtn:hover {
    background-color: #F8F9FA;
    border-color: #ADB5BD;
}

QPushButton#refreshBtn:disabled {
    color: #ADB5BD;
    background-color: #FFFFFF;
}

/* ---------- 输入控件 ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;  /* --color-neutral-0 */
    border: 1px solid #E9ECEF;  /* --color-neutral-200 */
    border-radius: 4px;  /* --radius-sm */
    padding: 6px 12px;  /* --space-3 */
    color: #343A40;  /* --color-neutral-800 */
    font-size: 14px;  /* --font-body */
    selection-background-color: #378ADD;  /* --color-primary-500 */
    selection-color: #ffffff;
    min-height: 32px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #378ADD;  /* --color-primary-500 */
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QDateEdit:disabled {
    background-color: #F8F9FA;  /* --color-neutral-50 */
    color: #ADB5BD;  /* --color-neutral-400 */
}

/* 搜索框样式 */
QLineEdit#searchEdit {
    background-color: #FFFFFF;
    border: 1px solid #E9ECEF;
    border-radius: 4px;
    padding: 0 12px 0 36px;  /* 左侧留出搜索图标空间 */
    min-height: 32px;
    max-width: 280px;
    color: #343A40;
    font-size: 14px;
}

QLineEdit#searchEdit:focus {
    border: 1px solid #378ADD;
}

/* ---------- 下拉框 ---------- */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #E9ECEF;  /* --color-neutral-200 */
    border-radius: 4px;  /* --radius-sm */
    padding: 0 12px;
    min-width: 80px;
    min-height: 32px;
    color: #343A40;  /* --color-neutral-800 */
    font-size: 14px;  /* --font-body-medium */
    font-weight: 500;
}

QComboBox:hover {
    border-color: #ADB5BD;  /* --color-neutral-400 */
}

QComboBox:focus {
    border: 1px solid #378ADD;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E9ECEF;
    border-radius: 8px;  /* --radius-md */
    selection-background-color: #E6F1FB;  /* --color-primary-50 */
    selection-color: #042C53;  /* --color-primary-900 */
    outline: none;
    padding: 4px;
}

/* ---------- 复选框 / 单选按钮 ---------- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #343A40;  /* --color-neutral-800 */
    font-size: 14px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator {
    border: 1.5px solid #ADB5BD;  /* --color-neutral-400 */
    background-color: #FFFFFF;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #378ADD;  /* --color-primary-500 */
    border-color: #378ADD;
}

QCheckBox::indicator:hover {
    border-color: #378ADD;
}

QRadioButton::indicator {
    border: 1.5px solid #ADB5BD;
    background-color: #FFFFFF;
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    background-color: #378ADD;
    border-color: #378ADD;
}

/* ---------- 表格 ---------- */
QTableView {
    background-color: #FFFFFF;  /* --color-neutral-0 */
    border: 1px solid #E9ECEF;  /* --color-neutral-200 */
    border-radius: 8px;  /* --radius-md */
    gridline-color: #F1F3F5;  /* --color-neutral-100 */
    selection-background-color: #B5D4F4;  /* --color-primary-100 */
    selection-color: #042C53;  /* --color-primary-900 */
    alternate-background-color: #F8F9FA;  /* --color-neutral-50 */
}

QTableView::item {
    padding: 0 16px;  /* --space-4 */
    border-bottom: 1px solid #F1F3F5;
    height: 44px;  /* 行高 44px */
}

QTableView::item:hover {
    background-color: #E6F1FB;  /* --color-primary-50 */
}

QTableView::item:selected {
    background-color: #B5D4F4;  /* --color-primary-100 */
}

QHeaderView::section {
    background-color: #F8F9FA;  /* --color-neutral-50 */
    color: #6C757D;  /* --color-neutral-600 */
    font-weight: 500;
    font-size: 12px;  /* --font-caption */
    padding: 0 16px;
    border: none;
    border-right: 1px solid #E9ECEF;
    border-bottom: 1px solid #E9ECEF;
    height: 44px;
}

QHeaderView::section:last {
    border-right: none;
}

/* ---------- 分组框 ---------- */
QGroupBox {
    border: 1px solid #E9ECEF;
    border-radius: 8px;  /* --radius-md */
    margin-top: 12px;
    padding-top: 16px;
    font-weight: 600;
    color: #343A40;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
    background-color: #F8F9FA;
    color: #378ADD;
}

/* ---------- 状态栏 ---------- */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E9ECEF;
    color: #6C757D;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

/* ---------- 日志面板 ---------- */
QTextEdit#logPanel {
    background-color: #212529;  /* --color-neutral-900 */
    color: #E9ECEF;
    border: none;
    border-top: 1px solid #343A40;
    font-family: "DIN Alternate", "Roboto Mono", "Consolas", "Courier New", monospace;
    font-size: 12px;
    padding: 6px;
}

/* ---------- 进度条 ---------- */
QProgressBar {
    background-color: #E9ECEF;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #343A40;
    font-size: 12px;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #378ADD;  /* --color-primary-500 */
    border-radius: 6px;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #E9ECEF;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #ADB5BD;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #E9ECEF;
    border-radius: 4px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #ADB5BD;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

/* ---------- 标签 ---------- */
QLabel#metricLabel {
    color: #6C757D;  /* --color-neutral-600 */
    font-size: 12px;  /* --font-caption */
}

QLabel#metricValue {
    color: #212529;  /* --color-neutral-900 */
    font-size: 20px;
    font-weight: 700;
    font-family: "DIN Alternate", "Roboto Mono", "Helvetica Neue", sans-serif;
}

QLabel#stockSymbol {
    color: #212529;
    font-size: 18px;
    font-weight: 700;
}

QLabel#stockName {
    color: #6C757D;
    font-size: 14px;
}

/* A股惯例：涨红跌绿（配合 +/- 符号，不单独依赖颜色） */
QLabel#priceUp {
    color: #E24B4A;  /* --color-up */
    font-weight: 700;
}

QLabel#priceDown {
    color: #639922;  /* --color-down */
    font-weight: 700;
}

QLabel#priceFlat {
    color: #6C757D;
    font-weight: 600;
}

/* ---------- 分割器 ---------- */
QSplitter::handle {
    background-color: #E9ECEF;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

/* ---------- 工具提示 ---------- */
QToolTip {
    background-color: #212529;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;  /* --radius-sm */
    padding: 4px 8px;
    font-size: 12px;
}

/* ---------- 菜单 ---------- */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E9ECEF;
    color: #343A40;
    font-size: 14px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #E6F1FB;
    color: #378ADD;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E9ECEF;
    border-radius: 8px;  /* --radius-md */
    padding: 4px;
}

QMenu::item {
    padding: 0 12px;
    height: 36px;  /* 项高 36px */
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #E6F1FB;  /* --color-primary-50 */
    color: #042C53;  /* --color-primary-900 */
}

QMenu::separator {
    height: 1px;
    background-color: #E9ECEF;
    margin: 4px 8px;
}

/* ---------- 底部批量操作浮栏 ---------- */
QFrame#batchActionBar {
    background-color: #FFFFFF;
    border: 1px solid #E9ECEF;
    border-radius: 8px;  /* --radius-md */
    padding: 8px 16px;
}

QLabel#batchCountLabel {
    color: #378ADD;  /* --color-primary-500 */
    font-size: 14px;
    font-weight: 500;
}

/* ---------- 分页 ---------- */
QPushButton#pageBtn {
    background-color: #FFFFFF;
    border: 1px solid #E9ECEF;
    border-radius: 4px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
    color: #343A40;
    font-size: 14px;
}

QPushButton#pageBtn:hover {
    background-color: #F1F3F5;
}

QPushButton#pageBtn:checked,
QPushButton#pageBtn#currentPage {
    background-color: #378ADD;  /* --color-primary-500 */
    color: #FFFFFF;
    border: none;
}

/* ---------- 工具栏分隔线 ---------- */
QFrame#toolbarSeparator {
    background-color: #E9ECEF;
    max-width: 1px;
    min-height: 24px;
    margin: 0 8px;
}
